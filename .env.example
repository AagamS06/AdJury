# AdJury environment variables.
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# See Rules.md §4 for the secrets policy.

# ── App ───────────────────────────────────────────────────────────────
# Public base URL, used to build absolute invite links (Day 24). Optional —
# if unset, invite links fall back to a relative path.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────────────────
# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only — full DB access. Never ship to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI provider ───────────────────────────────────────────────────────
# provider: anthropic | openai | groq   (only "anthropic" is wired up in Phase 1)
AI_PROVIDER=anthropic
# Server only. If left blank, the orchestrator runs in offline MOCK mode
# so tests and `npm run demo` still work without a paid key.
AI_API_KEY=
AI_MODEL=claude-haiku-4-5

# Sampling — low temperature keeps scoring reproducible/defensible.
AI_TEMPERATURE=0.2

# ── Billing (Stripe) ──────────────────────────────────────────────────
# Day 71 Stripe scaffold. Server only. TEST MODE ONLY in the scaffold — a
# live key (sk_live_…) is refused so no real charge can happen. Leave blank
# to run billing in offline MOCK mode (tests + local dev need no Stripe key).
STRIPE_SECRET_KEY=sk_test_your-stripe-test-secret-key
# The Stripe Price id for the AUD $20/mo entry plan (created in the Stripe
# dashboard, test mode). Blank ⇒ the entry plan renders but isn't checkout-ready.
STRIPE_PRICE_ENTRY_MONTHLY=price_your-entry-monthly-id
# Free-trial length in days, applied as a Stripe trial period at checkout.
# Config value so the "3-month promo vs 1-month" choice is a setting (0–90;
# default 30). See PRD §6.3 / DailyPlan Week 11.
STRIPE_TRIAL_DAYS=30
# Day 74 webhook. Server only. The signing secret (whsec_…) from the Stripe
# dashboard / `stripe listen`, used to VERIFY inbound webhook events before they
# touch billing. Blank ⇒ offline mock (the webhook route parses the body with no
# signature check, for local simulation only — never for real Stripe traffic).
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-signing-secret
